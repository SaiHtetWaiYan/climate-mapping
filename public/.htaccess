# Apache (e.g. Hostpoint) settings for the built site

# The web root may be a git checkout of the deploy branch: never serve the
# repository internals or the IIS/Tomcat config files
RedirectMatch 404 /\.git
RedirectMatch 404 ^/(WEB-INF|web\.config|\.htaccess)

# Township data
AddType application/geo+json .geojson

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/geo+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    # Vite assets have content hashes in their names
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    # Always revalidate the page and the data, so updates show up immediately
    <FilesMatch "\.(html|geojson)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule (.*) ./index.html [QSA,L]
